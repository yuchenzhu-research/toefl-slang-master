{
  "name": "toefl-slang-master",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "bin": {
    "coachpro": "./bin/coachpro.cjs",
    "contentpro": "./bin/contentpro.cjs",
    "dictpro": "./bin/dictpro.cjs",
    "dictpro-eval": "./bin/dictpro-eval.cjs",
    "tsm": "./bin/tsm.cjs"
  },
  "scripts": {
    "start": "ts-node src/index.ts",
    "setup": "ts-node src/init.ts",
    "doctor": "ts-node src/doctor.ts",
    "tsm": "ts-node src/app-cli.ts",
    "dict": "ts-node src/index.ts",
    "dict:dry": "ts-node src/index.ts --text \"a big deal\" --mode conversion --target toefl-writing --dry-run",
    "dict:providers": "ts-node src/index.ts --list-providers",
    "coach": "ts-node src/toefl-writing/cli.ts",
    "coach:dry": "ts-node src/toefl-writing/cli.ts --text \"I think technology is good because it helps us communicate. But it also has some bad effects. So we should use it carefully.\" --dry-run",
    "content": "ts-node src/content-parser/cli.ts",
    "content:dry": "ts-node src/content-parser/cli.ts --file README.md --focus full --dry-run",
    "dict:eval": "ts-node src/dictionary-pro/eval-cli.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuchenzhu-research/toefl-slang-master.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/yuchenzhu-research/toefl-slang-master/issues"
  },
  "homepage": "https://github.com/yuchenzhu-research/toefl-slang-master#readme",
  "dependencies": {
    "dotenv": "^17.3.1",
    "openai": "^6.25.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
