{
  "name": "spark-lang",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "bin": {
    "coachpro": "./bin/coachpro.cjs",
    "contentpro": "./bin/contentpro.cjs",
    "dictpro": "./bin/dictpro.cjs",
    "dictpro-eval": "./bin/dictpro-eval.cjs",
    "spark": "./bin/spark.cjs"
  },
  "scripts": {
    "start": "ts-node src/dictionary-pro/index.ts",
    "setup": "ts-node src/platform/init.ts",
    "doctor": "ts-node src/platform/doctor.ts",
    "spark": "ts-node src/app-cli.ts",
    "studio": "ts-node src/studio/index.ts",
    "web": "ts-node src/web/server.ts",
    "style": "ts-node src/style-engine/cli.ts",
    "dict": "ts-node src/dictionary-pro/index.ts",
    "dict:dry": "ts-node src/dictionary-pro/index.ts --text \"a big deal\" --mode conversion --target toefl-writing --dry-run",
    "dict:providers": "ts-node src/dictionary-pro/index.ts providers",
    "dict:bench": "ts-node src/dictionary-pro/bench-cli.ts",
    "coach": "ts-node src/toefl-writing/index.ts",
    "coach:dry": "ts-node src/toefl-writing/index.ts --text \"I think technology is good because it helps us communicate. But it also has some bad effects. So we should use it carefully.\" --dry-run",
    "content": "ts-node src/content-parser/index.ts",
    "content:dry": "ts-node src/content-parser/index.ts --file README.md --focus full --dry-run",
    "dict:eval": "ts-node src/dictionary-pro/eval-cli.ts",
    "test": "npm run test:ci",
    "test:ci": "rm -rf dist && tsc && node --test dist/tests/*.test.js",
    "desktop:dev": "npm run dev --prefix apps/desktop",
    "desktop:build": "npm run build --prefix apps/desktop",
    "desktop:build:mac": "npm run build:mac --prefix apps/desktop",
    "desktop:build:win": "npm run build:win --prefix apps/desktop"
  },
  "workspaces": [
    "apps/desktop"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuchenzhu-research/toefl-slang-master.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/yuchenzhu-research/toefl-slang-master/issues"
  },
  "homepage": "https://github.com/yuchenzhu-research/toefl-slang-master#readme",
  "dependencies": {
    "@mariozechner/pi-tui": "^0.66.1",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "dotenv": "^17.3.1",
    "openai": "^6.25.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
